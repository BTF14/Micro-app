# Gentleman Guardian Angel — local-only, zero API-cost baseline.
# Requires GGA + Ollama installed locally. No Git hook is installed automatically.
PROVIDER="ollama:qwen2.5-coder"
FILE_PATTERNS="*.ts,*.tsx,*.js,*.jsx,*.json,*.sql,*.yml,*.yaml"
EXCLUDE_PATTERNS="pnpm-lock.yaml,*.min.js,*.map"
RULES_FILE="AGENTS.md"
STRICT_MODE="true"
TIMEOUT="300"
PR_BASE_BRANCH="main"
